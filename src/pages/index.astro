---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import EmailOptIn from '../components/EmailOptIn.astro';
import { SITE } from '../config/site';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf()
);
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <section class="mx-auto max-w-5xl px-4 py-14 text-center">
    <h1 class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">{SITE.tagline}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-stone-600">{SITE.description}</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="mb-6 text-2xl font-bold text-stone-900">Latest Recipes</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-4 pb-16">
    <EmailOptIn />
  </section>
</BaseLayout>
