---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmazonButton from '../../components/AmazonButton.astro';
import EmailOptIn from '../../components/EmailOptIn.astro';
import RelatedRecipes from '../../components/RelatedRecipes.astro';
import RecipeSchema from '../../components/RecipeSchema.astro';
import { SITE } from '../../config/site';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { slug: recipe.data.slug },
    props: { recipe },
  }));
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const {
  title,
  heroImage,
  heroImageAlt,
  videoEmbedUrl,
  intro,
  ingredients,
  steps,
  whyItWorks,
  substitutions,
  tips,
  nutrition,
  amazonCta,
  datePublished,
  category,
  prepTime,
  cookTime,
  servings,
  metaDescription,
  slug,
} = recipe.data;

const heroImageUrl = new URL(heroImage.src, SITE.url).toString();
---

<BaseLayout title={title} description={metaDescription} image={heroImage.src} type="article" publishedTime={datePublished}>
  <RecipeSchema slot="head" recipe={recipe.data} heroImageUrl={heroImageUrl} />

  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-xs font-semibold uppercase tracking-wide text-amber-600">{category}</p>
    <h1 class="mt-1 text-3xl font-extrabold text-stone-900 sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-stone-600">{intro}</p>

    <div class="mt-4 flex flex-wrap items-center gap-3 no-print">
      <a href="#recipe-card" class="rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-stone-100">
        Jump to Recipe
      </a>
      <button
        type="button"
        onclick="window.print()"
        class="rounded-full border border-stone-300 px-4 py-2 text-sm font-semibold text-stone-700 hover:bg-stone-100"
      >
        Print Recipe
      </button>
    </div>

    <Image
      src={heroImage}
      alt={heroImageAlt ?? title}
      width={800}
      height={600}
      class="mt-6 w-full rounded-2xl object-cover"
      priority
    />

    <div class="prose prose-stone mt-8 max-w-none">
      <Content />
    </div>

    {videoEmbedUrl && (
      <div class="mt-8 aspect-video w-full overflow-hidden rounded-2xl no-print">
        <iframe
          src={videoEmbedUrl}
          title={`${title} video`}
          class="h-full w-full"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <!-- Printable recipe card -->
    <section id="recipe-card" class="mt-10 scroll-mt-6 rounded-2xl border border-stone-200 bg-stone-50 p-6">
      <h2 class="text-2xl font-bold text-stone-900">{title}</h2>
      <dl class="mt-3 grid grid-cols-2 gap-3 text-sm text-stone-600 sm:grid-cols-4">
        <div><dt class="font-semibold text-stone-800">Prep Time</dt><dd>{prepTime}</dd></div>
        <div><dt class="font-semibold text-stone-800">Cook Time</dt><dd>{cookTime}</dd></div>
        <div><dt class="font-semibold text-stone-800">Servings</dt><dd>{servings}</dd></div>
        <div><dt class="font-semibold text-stone-800">Category</dt><dd>{category}</dd></div>
      </dl>

      <h3 class="mt-6 text-lg font-bold text-stone-900">Ingredients</h3>
      <ul class="mt-2 list-inside list-disc space-y-1 text-stone-700">
        {ingredients.map((item) => <li>{item}</li>)}
      </ul>

      <h3 class="mt-6 text-lg font-bold text-stone-900">Method</h3>
      <ol class="mt-2 list-inside list-decimal space-y-2 text-stone-700">
        {steps.map((step) => <li>{step}</li>)}
      </ol>

      {nutrition && (
        <>
          <h3 class="mt-6 text-lg font-bold text-stone-900">Nutrition (per serving)</h3>
          <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
            {nutrition.calories && <li>Calories: {nutrition.calories}</li>}
            {nutrition.protein && <li>Protein: {nutrition.protein}</li>}
            {nutrition.fat && <li>Fat: {nutrition.fat}</li>}
            {nutrition.carbs && <li>Carbs: {nutrition.carbs}</li>}
            {nutrition.fiber && <li>Fiber: {nutrition.fiber}</li>}
            {nutrition.sugar && <li>Sugar: {nutrition.sugar}</li>}
          </ul>
        </>
      )}
    </section>

    {whyItWorks.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-stone-900">Why This Works</h2>
        <ul class="mt-3 list-inside list-disc space-y-2 text-stone-700">
          {whyItWorks.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {substitutions.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-stone-900">Substitutions</h2>
        <ul class="mt-3 list-inside list-disc space-y-2 text-stone-700">
          {substitutions.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {tips.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-stone-900">Tips</h2>
        <ul class="mt-3 list-inside list-disc space-y-2 text-stone-700">
          {tips.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <section class="mt-10 no-print">
      <AmazonButton label={amazonCta} />
    </section>

    <section class="mt-10 no-print">
      <EmailOptIn />
    </section>

    <div class="no-print">
      <RelatedRecipes currentSlug={slug} category={category} />
    </div>
  </article>
</BaseLayout>
