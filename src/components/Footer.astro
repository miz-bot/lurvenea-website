---
import { SITE } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-stone-200 bg-stone-50">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-4 py-8 text-sm text-stone-500 sm:flex-row sm:justify-between">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    <nav class="flex gap-4">
      <a href="/about" class="hover:text-stone-900">About</a>
      <a href="/privacy" class="hover:text-stone-900">Privacy</a>
      <a href="/shop" class="hover:text-stone-900">Shop</a>
    </nav>
  </div>
</footer>
